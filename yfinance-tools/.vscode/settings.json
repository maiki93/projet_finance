{
    // exclude files from copilot suggestions
    "github.copilot.excludedFiles": ["notes/**"],
    // enable the Agent Debug Logs
    "github.copilot.chat.agentDebugLog.fileLogging.enabled": true,

    "files.exclude": {
        "**/__pycache__": true,
        "**/.pytest_cache": true,
        "**/*.pyc": true,
        "**/.venv": true,
        // they are defaults, do not need to include
        // "**/.git": true,
        // "**/.svn": true,
        // "**/.hg": true,
        // "**/.DS_Store": true,
        // "**/Thumbs.db": true
    },
    // optimization
    "search.exclude": {
        "**/__pycache__": true,
        "**/.pytest_cache": true,
        "**/*.pyc": true,
        // defaults
        //"**/node_modules": true,
        //"**/bower_components": true,
        //"**/*.code-search": true
    },
    //
    // added automatically when setting up test runner in IDE
    //
    "python.testing.pytestArgs": [
        "tests"
    ],
    "python.testing.unittestEnabled": false,
    "python.testing.pytestEnabled": true,

}